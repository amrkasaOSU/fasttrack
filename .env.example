# =====================================================================
# FastTrack - example environment file.  Copy to .env and fill in.
#   cp .env.example .env
# Every variable the app reads is documented here. Nothing in .env is
# ever committed (see .gitignore).
# =====================================================================

# ---------------------------------------------------------------------
# Core / database  (defaults match docker-compose.yml)
# ---------------------------------------------------------------------
POSTGRES_DB=fasttrack
POSTGRES_USER=fasttrack
POSTGRES_PASSWORD=fasttrack_local_dev_only
# JDBC url used by the backend. In Docker Compose the host is "postgres".
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fasttrack
SPRING_DATASOURCE_USERNAME=fasttrack
SPRING_DATASOURCE_PASSWORD=fasttrack_local_dev_only

# ---------------------------------------------------------------------
# Redis (sessions, rate limiting, LLM response cache)
# ---------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ---------------------------------------------------------------------
# Encryption of Gmail refresh tokens at rest (AES-256-GCM).
# MUST be 32 bytes, base64-encoded. Generate one with:
#   openssl rand -base64 32
# If unset, the app starts but Gmail connection is disabled.
# ---------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# Google OAuth2 (Gmail read-only). See docs/google-setup.md.
# If either value is blank the app runs in "Gmail not configured" mode:
# demo login and every non-Gmail feature still work.
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------
# LLM provider - any OpenAI-compatible /chat/completions endpoint.
#   Groq  (free tier):  https://api.groq.com/openai/v1
#   Ollama (local):     http://localhost:11434/v1   (LLM_API_KEY=ollama)
# If OPENAI_API_KEY is blank the app falls back to the deterministic
# rule-based classifier and the fit scorer's heuristic path.
# ---------------------------------------------------------------------
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# ---------------------------------------------------------------------
# App behaviour
# ---------------------------------------------------------------------
# Where the browser reaches the frontend (CORS + OAuth2 redirect target)
APP_FRONTEND_URL=http://localhost:3000
# Where the browser reaches the backend
APP_BACKEND_URL=http://localhost:8080
# Set true only behind HTTPS (marks session cookie Secure)
APP_SECURE_COOKIES=false
# Enable the seeded, read-only demo account + "Try the demo" button
APP_DEMO_ENABLED=true
# Gmail sync window on first connect, and the scheduled sync interval
APP_SYNC_INITIAL_DAYS=120
APP_SYNC_CRON=0 */15 * * * *

# ---------------------------------------------------------------------
# Host ports published by docker-compose. Change these if something else
# on your machine already listens on 3000 / 8080, and keep
# APP_FRONTEND_URL and NEXT_PUBLIC_API_BASE_URL pointing at them.
# ---------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------------------------------------------------------------------
# Frontend (Next.js) - only NEXT_PUBLIC_* reach the browser
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
